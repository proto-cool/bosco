# dunce's own account (EXPERIMENT.md 4).  Never bosco's handle or app password.
BOSCO_HANDLE=dunce.proto.cool
BOSCO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BOSCO_OPERATOR=proto.cool
BOSCO_IGNORE_LIST=bosco-ignore
# optional
BOSCO_PDS=
BOSCO_RSYNC_TARGET=
BOSCO_ALERT_URL=
BOSCO_BROWSE=12
BOSCO_LANGS=en
BOSCO_EPISODE_BUDGET=600
# BOSCO_BRAIN and BOSCO_IDENTITY are set in the quadlet, not here: they are what makes this
# process a control rather than a second Bosco, and they belong with the unit that runs it.

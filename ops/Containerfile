FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev make sqlite3 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .
RUN uv sync --frozen --no-dev && make -C kernel CFLAGS="-O3 -march=native -std=c99 -fPIC -fno-fast-math -ffp-contract=off -fexcess-precision=standard -fno-trapping-math"
# data/raw (feathers) and state/ are volumes; data/cache is built on first run
ENV BOSCO_LEDGER=/app/state/ledger.sqlite PYTHONUNBUFFERED=1
ENTRYPOINT ["/app/.venv/bin/bosco"]
CMD ["run"]
